// Define MAC if not predefined
#define MAC {  0x00, 0xAA, 0xBB, 0xCC, 0xDE, 0x02 }

// Device static IPv4 settings
#define DEVICE_IP   { 192, 168, 1, 200 }
#define DEVICE_DNS  { 192, 168, 1, 1 }
#define DEVICE_GW   { 192, 168, 1, 1 }
#define DEVICE_MASK { 255, 255, 255, 0 }

// MQTT Broker ip and port
#define BROKER { 192, 168, 0, 50 }
#define BROKER_PORT 1883

// MQTT USER
#define MQTT_CLIENT_ID "id"
#define MQTT_USER "username"
#define MQTT_PWD "password"

// MQTT topics (optional; defaults exist if omitted)
#define MQTT_TOPIC_CMD "garage/gate/cmd"
#define MQTT_TOPIC_STATUS "garage/gate/status"

// Gate movement calibration
// Set to 1 if OPEN/CLOSE relay wiring is reversed, otherwise 0.
#define GATE_DIRECTION_INVERTED 0
// Set to 1 to enable position estimation/publishing, 0 to disable.
#define GATE_POSITION_ENABLED 1
// Full travel times in seconds, used for position estimation.
#define GATE_TRAVEL_UP_SEC 13
#define GATE_TRAVEL_DOWN_SEC 19
